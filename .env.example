# Public Branch test-key configuration for a custom native build.
NATIVE_SDK_BUILD=0
EXPO_PUBLIC_BRANCH_KEY=key_test_REPLACE_ME
EXPO_PUBLIC_BRANCH_DOMAIN=your-app.test-app.link
EXPO_PUBLIC_BRANCH_ALTERNATE_DOMAIN=your-app-alternate.test-app.link

# Local paths or EAS file-secret values. Never commit the real files.
GOOGLE_SERVICES_JSON=./google-services.json
GOOGLE_SERVICES_PLIST=./GoogleService-Info.plist
EAS_PROJECT_ID=
